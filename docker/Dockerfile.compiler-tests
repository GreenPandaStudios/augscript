# syntax=docker/dockerfile:1
FROM node:24-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends git clang libclang-rt-14-dev make cmake m4 autoconf automake libtool python3 zlib1g-dev ca-certificates patchelf time \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/augscript
COPY . .
RUN npm ci --no-audit --no-fund \
    && node scripts/bootstrap-native.mjs \
    && node scripts/prepare-llvm-tools.mjs \
    && node scripts/build-runtime-pack.mjs \
    && chmod +x /opt/augscript/bin/aug.mjs \
    && ln -s /opt/augscript/bin/aug.mjs /usr/local/bin/aug
ENV AUG_LLVM_HOME=/opt/augscript/.aug-build/llvm-tools
WORKDIR /workspace
ENTRYPOINT ["aug"]
CMD ["--help"]
