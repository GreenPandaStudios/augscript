# syntax=docker/dockerfile:1
FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
ARG AUG_VERSION=1.0.0
LABEL org.opencontainers.image.title="August runtime" \
      org.opencontainers.image.source="https://github.com/GreenPandaStudios/augscript" \
      org.opencontainers.image.version=${AUG_VERSION}
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system august \
    && useradd --system --gid august --home-dir /app august \
    && mkdir /app \
    && chown august:august /app
WORKDIR /app
USER august
ENTRYPOINT ["/app/program"]
