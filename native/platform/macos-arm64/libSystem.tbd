--- !tapi-tbd-v3
# Independently authored public OS imports for LLVM programs and the core archive.
archs: [ arm64 ]
platform: macosx
install-name: /usr/lib/libSystem.B.dylib
current-version: 1.0.0
compatibility-version: 1.0.0
exports:
  - archs: [ arm64 ]
    symbols: [ ___assert_rtn, ___error, ___stack_chk_fail, ___stack_chk_guard, ___stderrp, ___stdoutp, __tlv_bootstrap, _abort, _abs, _bzero, _calloc, _exit, _fclose, _ferror, _fflush, _fopen, _fprintf, _fputs, _fread, _free, _fseek, _ftell, _fwrite, _getenv, _getpid, _labs, _malloc, _memchr, _memcmp, _memcpy, _memmove, _memset, _printf, _snprintf, _newlocale, _uselocale, _freelocale, _clock_gettime, _pthread_cond_broadcast, _pthread_cond_timedwait, _pthread_cond_wait, _pthread_create, _pthread_detach, _pthread_once, _strtod, _strtol, _strtoull, _sysconf, _pthread_mutex_destroy, _pthread_mutex_init, _pthread_mutex_lock, _pthread_mutex_trylock, _pthread_mutex_unlock, _putchar, _puts, _realloc, _strcmp, _strlen, _time, dyld_stub_binder ]
...
