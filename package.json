{
  "name": "augscript",
  "version": "1.0.0",
  "description": "August language development monorepo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GreenPandaStudios/augscript.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "test:compatibility": "node --test tests/package-compatibility.test.mjs tests/user-packages.test.mjs tests/native-packages.test.mjs tests/native-artifacts.test.mjs tests/native-bindings.test.mjs",
    "test:setup-cold": "AUG_TEST_COLD_NATIVE=1 node --test tests/native-setup-cold.test.mjs",
    "test:docker": "node scripts/test-docker.mjs",
    "test:sanitizers": "node scripts/sanitize-core.mjs",
    "bench:test-compilation": "node scripts/benchmark-test-compilation.mjs",
    "test:safety": "node scripts/audit-generated-c.mjs",
    "bench:compare": "node scripts/benchmark-suite.mjs",
    "bench:kernels": "node scripts/benchmark-kernels.mjs",
    "test:gyms": "node scripts/run-gyms.mjs",
    "test:gyms:full": "node scripts/run-gyms.mjs --profile full",
    "qualification:render": "node scripts/render-qualification.mjs",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "build:packages": "node scripts/build-packages.mjs",
    "package:packages": "node scripts/pack-packages.mjs",
    "test:packages": "node scripts/test-packages.mjs",
    "version:check": "node scripts/version.mjs --check",
    "package:extension": "npm --prefix vscode run package",
    "bench:greetings": "node scripts/benchmark-greetings.mjs",
    "test:conformance": "node scripts/check-language-conformance.mjs",
    "test:reliability": "node scripts/qualify-runtime.mjs",
    "test:editor": "node scripts/qualify-editor.mjs",
    "test:upgrade": "node scripts/qualify-cli-upgrade.mjs",
    "unicode:generate": "node scripts/generate-graphemes.mjs",
    "unicode:check": "node scripts/generate-graphemes.mjs --check"
  },
  "devDependencies": {
    "@types/markdown-it-container": "4.0.1",
    "@types/node": "26.6.3",
    "@vscode/test-electron": "3.1.0",
    "jsdom": "26.1.0",
    "markdown-it-container": "4.0.0",
    "mermaid": "12.1.0",
    "minizlib": "3.1.0",
    "tar": "7.5.22",
    "typescript": "7.0.2",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "6.4.3",
    "katex": "0.18.2",
    "source-map-js": "1.2.2"
  }
}
