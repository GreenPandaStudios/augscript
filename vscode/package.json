{
  "name": "augscript",
  "displayName": "AugScript",
  "description": "Language support for AugScript",
  "icon": "media/augscript.png",
  "version": "0.23.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/GreenPandaStudios/augscript.git",
    "directory": "vscode"
  },
  "homepage": "https://GreenPandaStudios.github.io/augscript/",
  "bugs": {
    "url": "https://github.com/GreenPandaStudios/augscript/issues"
  },
  "publisher": "augscript",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onLanguage:augscript",
    "onCommand:augscript.build",
    "onCommand:augscript.run",
    "onCommand:augscript.test",
    "onCommand:augscript.refreshTests",
    "onCommand:augscript.openTestingGuide",
    "onCommand:augscript.openGuide",
    "onCommand:augscript.openWebGuide",
    "onCommand:augscript.openDiagnostics",
    "onDebugResolve:augscript",
    "onDebugInitialConfigurations:augscript"
  ],
  "scripts": {
    "vscode:prepublish": "node prepare.mjs",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/GreenPandaStudios/augscript/blob/main/vscode --baseImagesUrl https://github.com/GreenPandaStudios/augscript/raw/main/vscode",
    "artwork": "node scripts/render-artwork.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.1-1",
    "sharp": "0.35.4"
  },
  "contributes": {
    "snippets": [
      {
        "language": "augscript",
        "path": "./augscript.code-snippets"
      }
    ],
    "configurationDefaults": {
      "[augscript]": {
        "editor.tabCompletion": "on",
        "editor.parameterHints.enabled": true,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        }
      }
    },
    "languages": [
      {
        "id": "augscript",
        "aliases": [
          "AugScript",
          "augscript"
        ],
        "extensions": [
          ".aug"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/aug-light.svg",
          "dark": "./icons/aug.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "augscript",
        "scopeName": "source.augscript",
        "path": "./syntaxes/augscript.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "augscript-icons",
        "label": "AugScript Icons",
        "path": "./icons/augscript-icon-theme.json"
      }
    ],
    "breakpoints": [
      {
        "language": "augscript"
      }
    ],
    "debuggers": [
      {
        "type": "augscript",
        "label": "AugScript (LLDB)",
        "languages": [
          "augscript"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "project": {
                "type": "string",
                "description": "Project folder containing main.aug."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "augscript",
            "request": "launch",
            "name": "Debug AugScript"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "augscript.spec",
        "title": "AugScript: Generate Specifications"
      },
      {
        "command": "augscript.openSpec",
        "title": "AugScript: Open Current File Specification"
      },
      {
        "command": "augscript.migrate",
        "title": "AugScript: Upgrade Project Syntax"
      },
      {
        "command": "augscript.openWelcome",
        "title": "AugScript: Open Welcome"
      },
      {
        "command": "augscript.enableIcons",
        "title": "AugScript: Enable File Icons"
      },
      {
        "command": "augscript.explain",
        "title": "AugScript: Explain Current File"
      },
      {
        "command": "augscript.context",
        "title": "AugScript: Gather Context for Current File"
      },
      {
        "command": "augscript.debugTerminal",
        "title": "AugScript: Debug in LLDB Terminal"
      },
      {
        "command": "augscript.build",
        "title": "AugScript: Build Project"
      },
      {
        "command": "augscript.run",
        "title": "AugScript: Run Project"
      },
      {
        "command": "augscript.test",
        "title": "AugScript: Test Project"
      },
      {
        "command": "augscript.refreshTests",
        "title": "AugScript: Refresh Tests"
      },
      {
        "command": "augscript.openTestingGuide",
        "title": "AugScript: Open Testing Guide"
      },
      {
        "command": "augscript.openGuide",
        "title": "AugScript: Open Language Guide"
      },
      {
        "command": "augscript.openDiagnostics",
        "title": "AugScript: Open Diagnostics Guide"
      },
      {
        "command": "augscript.openToolingGuide",
        "title": "AugScript: Open Native Tooling Guide"
      },
      {
        "command": "augscript.openWebGuide",
        "title": "AugScript: Open Web and Crypto Guide"
      },
      {
        "command": "augscript.installPackages",
        "title": "AugScript: Install Source Packages"
      }
    ],
    "configuration": {
      "title": "AugScript",
      "properties": {
        "augscript.inferredContractHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred return types, mutations, capability use, and checked errors as non-editable inline hints. These hints do not change saved source."
        },
        "augscript.lldbDapPath": {
          "type": "string",
          "default": "",
          "description": "Path to LLVM lldb-dap for source debugging. Empty searches PATH and the selected Xcode toolchain."
        },
        "augscript.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Path to Node.js 24 or later for the AugScript compiler."
        },
        "augscript.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a custom aug CLI executable or bin/aug.mjs."
        },
        "augscript.nativeHome": {
          "type": "string",
          "default": "",
          "description": "Optional absolute native cache directory containing sources/ and prefix/. Native commands prepare required dependencies automatically; use this setting to share a cache with the CLI."
        }
      }
    }
  }
}
